{
	"name": "n8n-nodes-narkis",
	"version": "0.1.0",
	"description": "n8n community node for the public Narkis headshot photographer directory: photographers, listed prices, covered locations and photo guides. No credentials needed.",
	"license": "MIT",
	"homepage": "https://github.com/SignedAdam/n8n-nodes-narkis#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"narkis",
		"headshot",
		"photographer",
		"photography"
	],
	"author": {
		"name": "Narkis.ai",
		"email": "support@narkis.ai"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SignedAdam/n8n-nodes-narkis.git"
	},
	"bugs": {
		"url": "https://github.com/SignedAdam/n8n-nodes-narkis/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [],
		"nodes": [
			"dist/nodes/Narkis/Narkis.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
